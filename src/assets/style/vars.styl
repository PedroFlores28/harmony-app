// --- Harmony brand palette ---
harmony-primary = #5C0F39
harmony-primary-dark = #450B2B
harmony-primary-light = #7A1A4E
harmony-muted = #8B6B80
harmony-soft-bg = #f5eef2
harmony-soft-border = #e8dce3
harmony-primary-12 = #5c0f3912
harmony-primary-18 = #5c0f3918
harmony-primary-22 = #5c0f3922
harmony-primary-33 = #5c0f3933
harmony-primary-44 = #5c0f3944
harmony-primary-55 = #5c0f3955
harmony-primary-57 = #5c0f3957
harmony-primary-66 = #5c0f3966
harmony-primary-7d = #5c0f397d
harmony-primary-85 = #5c0f3985

// Legacy aliases (migrated from fuchsia palette)
c-main-purple = harmony-primary
c-main-light-purple = harmony-primary-light

// breakpoints
m-break  = 767px
d-break  = 768px


// colors
c-gray      = #aaa3a3
c-ligh-gray = #eaebec

c-black = #282828
c-blue  = #0093cb
c-semi-dark-blue  = #001c50
c-dark-blue  = #00112b

c-main-blue   = #086eb6
c-main-green  = #5db02c

c-main-light-green  = #4BB167

c-main-red    = #991920
c-main-golden = #d9ad26

c-main-turk = #4fbbc3

// c-main-purple = #351251
// c-main-light-purple = #ab49cc
// c-main-light-green = #5db02c
c-main-light-green = #008F39
c-main-green = #326c10


c-red    = #ef476f
c-orange = #f78c6b
c-yellow = #ffd166
c-green  = #06d6a0

c-ligh-green = #80c700

c-msn = #00B2FF


// layout
_grid()
  display grid
  grid-template-rows auto 1fr auto

_flex()
  display flex
  justify-content space-between
  align-items center

// --- Dark/Light mode variables ---
// Paleta principal
color-primary = harmony-primary
color-secondary = harmony-primary-dark
color-accent = #f78c6b
color-error = #ef476f
color-success = #06d6a0
color-warning = #ffd166

// Light mode
light-bg = #f7f8fa
light-bg-card = #fff
light-text = #222
light-border = #e0e0e0

// Dark mode
dark-bg = #181a1b
dark-bg-card = #23272f
dark-text = #f1f1f1
dark-border = #333

dark-primary = #4fbbc3

global-font = 'Inter', 'Roboto', 'Montserrat', Arial, sans-serif

// Variable para modo actual
app-bg = light-bg
app-bg-card = light-bg-card
app-text = light-text
app-border = light-border

